# Optional. You do NOT need this to run the app.
#
# Each user supplies their own Etherscan key at runtime (menu → "API key"), which
# is stored in their browser and never bundled. This variable only exists so a
# self-hosted deployment can bake in a key of its own, and since this is a
# client-side app, anything set here ships in the bundle and is readable by every
# visitor, on your account's rate limit. Leave it empty unless you mean it.
VITE_ETHERSCAN_API_KEY=
